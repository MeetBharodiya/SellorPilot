# Normalize line endings to LF for all text files
* text=auto eol=lf

# Force LF for these specific file types
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.prisma text eol=lf
*.mjs   text eol=lf
*.env   text eol=lf

# Binary files — no line-ending conversion
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.svg   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
