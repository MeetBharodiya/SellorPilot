// This is your Prisma schema file for SellorPilot
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ========================
// USER — Platform account
// ========================
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shops     Shop[]
  sessions  Session[]
  accounts  Account[]
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ========================
// SHOP — Connected Etsy shop
// ========================
model Shop {
  id            String   @id @default(cuid())
  userId        String
  etsyShopId    String   @unique
  shopName      String
  shopUrl       String?
  iconUrl       String?
  accessToken   String   // encrypted
  refreshToken  String?  // encrypted
  tokenExpiry   DateTime?
  currency      String   @default("USD")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings      Listing[]
  orders        Order[]
  shippingProfiles ShippingProfile[]
  scheduledJobs ScheduledJob[]
}

// ========================
// LISTING — Etsy product listing
// ========================
model Listing {
  id              String   @id @default(cuid())
  shopId          String
  etsyListingId   String?  @unique  // null until published to Etsy
  title           String
  description     String?
  price           Float    @default(0)
  quantity        Int      @default(1)
  state           String   @default("draft") // draft, active, inactive, expired, sold_out
  tags            String   @default("[]")    // JSON array stored as string (SQLite)
  materials       String   @default("[]")   // JSON array
  taxonomyId      Int?
  taxonomyPath    String?
  shippingProfileId String?
  section         String?
  renewalOption   String   @default("automatic") // automatic, manual
  isDigital       Boolean  @default(false)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop            Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  images          ListingImage[]
  variations      ListingVariation[]
}

// ========================
// LISTING IMAGE
// ========================
model ListingImage {
  id            String  @id @default(cuid())
  listingId     String
  etsyImageId   String?
  url           String
  altText       String?
  rank          Int     @default(0)
  isLocalOnly   Boolean @default(false) // true = uploaded locally, not yet pushed to Etsy

  listing       Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

// ========================
// LISTING VARIATION (size, color, style)
// ========================
model ListingVariation {
  id          String  @id @default(cuid())
  listingId   String
  propertyName String  // e.g. "Size", "Color"
  value       String  // e.g. "Medium", "Pink"
  price       Float?
  quantity    Int     @default(0)
  sku         String?
  isAvailable Boolean @default(true)

  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

// ========================
// ORDER — Etsy order/receipt
// ========================
model Order {
  id              String   @id @default(cuid())
  shopId          String
  etsyReceiptId   String   @unique
  buyerEmail      String?
  buyerName       String?
  totalPrice      Float
  subtotal        Float?
  shippingCost    Float?
  taxAmount       Float?
  status          String   @default("paid") // paid, shipped, cancelled, delivered, refunded
  trackingCode    String?
  carrier         String?
  shippingAddress String?  // JSON stored as string
  notes           String?
  createdAt       DateTime
  updatedAt       DateTime @updatedAt

  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items           OrderItem[]
}

// ========================
// ORDER ITEM — Line item in an order
// ========================
model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  etsyListingId   String?
  title           String
  quantity        Int
  price           Float
  variationText   String? // e.g. "Size: Medium, Color: Pink"

  order           Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ========================
// SHIPPING PROFILE
// ========================
model ShippingProfile {
  id                    String  @id @default(cuid())
  shopId                String
  etsyShippingProfileId String? @unique
  name                  String
  originCountry         String  @default("IN")
  processingTimeMin     Int     @default(1)
  processingTimeMax     Int     @default(3)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  shop                  Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

// ========================
// SCHEDULED JOB — Listing publish queue
// ========================
model ScheduledJob {
  id          String   @id @default(cuid())
  shopId      String
  type        String   // publish_listing, bulk_edit, sync_listings, sync_orders
  payload     String   // JSON stored as string
  runAt       DateTime
  status      String   @default("pending") // pending, running, done, failed
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop        Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}
